/* Minimal gruvbox-dark rofi theme. */

configuration {
    show-icons:          false;
    display-run:         "run";
    display-drun:        "apps";
    display-window:      "window";
    drun-display-format: "{name}";
}

* {
    /* gruvbox dark */
    bg-window:   #1d2021f2;
    bg-input:    #3c3836ff;
    bg-select:   #689d6aff;
    border-col:  #504945ff;
    fg:          #ebdbb2ff;
    fg-dim:      #928374ff;
    fg-invert:   #1d2021ff;
    yellow:      #d79921ff;

    background-color: transparent;
    text-color:       @fg;
    font:             "CaskaydiaCove Nerd Font Mono 13";
}

window {
    transparency:     "real";
    background-color: @bg-window;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    width:            800px;
    location:         center;
    padding:          0px;
}

mainbox {
    padding:  14px;
    spacing:  12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg-input;
    text-color:       @fg;
    border-radius:    8px;
    padding:          10px 12px;
    spacing:          10px;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @yellow;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "";
    placeholder-color: @fg-dim;
    cursor:            text;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          2px;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 12px;
    border-radius:    8px;
    cursor:           pointer;
}

/* every unselected state must be pinned, or rofi's default light
   normal-background bleeds through and the rows turn cream */
element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: @bg-select;
    text-color:       @fg-invert;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
